# Copier ce fichier en « .env.local » et remplir avec les valeurs de VOTRE
# projet Supabase (Project Settings → API). Ces deux valeurs sont publiques
# par nature (elles vont dans le navigateur) : la sécurité est dans la base
# (sécurité par ligne), jamais dans le secret de ces clés.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Adresse publique du site (sert aux liens et QR de partage).
# En local : http://localhost:5173
VITE_ADRESSE_PUBLIQUE=https://votre-site.pages.dev

# Adresse e-mail de l'administrateur MONTRÉE AU PUBLIC (message « pour toute
# correction, écrivez à l'administrateur » et avis sur les données). Vide :
# aucune adresse n'est affichée. C'est l'administrateur qui choisit laquelle publier.
VITE_EMAIL_ADMINISTRATEUR=

# Paiement (offre Famille). Laisser à false tant que Stripe n'est pas
# branché : le bouton de paiement n'apparaît pas, le reste marche.
VITE_STRIPE_ACTIF=false
